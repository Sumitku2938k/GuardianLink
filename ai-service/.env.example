# ==============================================================================
# GuardianLink AI Microservice — Environment Configuration Template
# ==============================================================================
# SAFE DEVELOPMENT DEFAULTS ONLY — NEVER COMMIT REAL PRODUCTION SECRETS
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Internal Service-to-Service Security Key
# Must match AI_SERVICE_KEY in GuardianLink server environment
INTERNAL_SERVICE_KEY=dev_internal_secret_change_in_production

# Standalone Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=missing_person_faces
QDRANT_TIMEOUT_SECONDS=10

# Biometric Engine & Model Settings
MODEL_NAME=buffalo_l
DETECTION_SIZE=640,640
INSIGHTFACE_HOME=

# Provisional Similarity Threshold (Cosine metric, range -1.0 to 1.0)
# Matches Phase 6.1 baseline; fine-tuned during Phase 6.11 evaluation
FACE_MATCH_THRESHOLD=0.60

# Safe Image Upload Limits (bytes)
# 10485760 = 10 MB default limit
MAX_UPLOAD_SIZE_BYTES=10485760
