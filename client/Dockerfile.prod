# ==============================================================================
# GuardianLink Frontend Client — Hardened Production Dockerfile
# Stage 1: Build static assets via Vite
# Stage 2: Serve optimized assets via unprivileged Nginx Alpine
# ==============================================================================

# Stage 1: Build Frontend Artifacts
FROM node:20-alpine AS builder

WORKDIR /app

# Copy dependency specifications and install cleanly
COPY package*.json ./
RUN npm ci || npm install

# Copy application source code
COPY . .

# Build-time argument for production API gateway
ARG VITE_API_BASE_URL=http://localhost:5000
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

# Compile production bundle
RUN npm run build

# Stage 2: Minimal Production Serving Image
FROM nginx:alpine

# Remove default nginx boilerplate configuration
RUN rm -rf /etc/nginx/conf.d/*

# Copy custom Nginx SPA configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose port 3000
EXPOSE 3000

# Health check probe against local Nginx endpoint
HEALTHCHECK --interval=20s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1:3000/healthz || exit 1

# Start Nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
