# ==============================================================================
# GuardianLink — Canonical Production & Development Environment Contract
# Phase 15: Production Readiness, Secret Management & Deployment Validation
# ==============================================================================
# SAFE TEMPLATE ONLY — NEVER COMMIT REAL PRODUCTION SECRETS TO SOURCE CONTROL
# Copy this template to .env at the repository root for custom local development:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Runtime Mode
# ------------------------------------------------------------------------------
# Set to 'production' in deployed environments; 'development' for local work
NODE_ENV=development
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. Node.js Express Backend & Authentication Secrets
# ------------------------------------------------------------------------------
# Port on which the backend Express server listens inside the container
PORT=5000

# Canonical public frontend URL used for CORS origin allowlisting & Cookie domains
# In production, must be the HTTPS domain of the client (e.g., https://guardianlink.org)
CLIENT_URL=http://localhost:3000

# Cryptographic signing secret for JWT tokens (Min 32 characters required in production)
# Generate with: openssl rand -hex 32
JWT_SECRET=your_jwt_secret_here_min_32_chars_long

# Cryptographic secret for server-side Redis session storage
# Generate with: openssl rand -hex 32
SESSION_SECRET=your_session_secret_here_min_32_chars

# Cryptographic secret for signed HttpOnly authentication cookies
# Generate with: openssl rand -hex 32
COOKIE_SECRET=your_cookie_secret_here_min_32_chars

# ------------------------------------------------------------------------------
# 3. Database & Cache Connectivity (Local or Managed Cloud)
# ------------------------------------------------------------------------------
# MongoDB connection URI (supports standalone, replica sets, or managed Atlas: mongodb+srv://)
# Local Compose default: mongodb://mongo:27017/guardianlink
# Local Host default: mongodb://localhost:27017/guardianlink
MONGO_URI=mongodb://localhost:27017/guardianlink

# Redis cache and session URL (supports redis:// or TLS rediss:// for Upstash/ElastiCache)
# Local Compose default: redis://redis:6379
# Local Host default: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 4. Service-to-Service Security & AI Microservice
# ------------------------------------------------------------------------------
# Shared pre-shared secret key for Express-to-FastAPI service authentication.
# Transmitted via 'X-Internal-Service-Key' header on all /internal/* routes.
# SECURITY REQUIREMENT: Min 16 chars; rejects placeholders in production.
# Generate with: openssl rand -hex 32
INTERNAL_SERVICE_KEY=your_secure_internal_service_key_here

# AI microservice endpoint for internal backend communication
# Local Compose default: http://ai-service:8000
# Local Host default: http://127.0.0.1:8000
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 5. Cloudinary Cloud Media Storage
# ------------------------------------------------------------------------------
# Server-side only credentials for child profile and sighting photo storage
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# ------------------------------------------------------------------------------
# 6. Initial Administrator Bootstrap (First Startup Only)
# ------------------------------------------------------------------------------
# Used to seed initial admin account if NO admin exists in the database.
# In production, ADMIN_PASSWORD must be a secure password of min 12 characters.
ADMIN_NAME=GuardianLink Administrator
ADMIN_EMAIL=admin@guardianlink.local
ADMIN_PASSWORD=your_secure_admin_password_min_12_chars
ADMIN_PHONE=9999900000

# ------------------------------------------------------------------------------
# 7. AI Microservice & Biometric Vector Configuration
# ------------------------------------------------------------------------------
HOST=0.0.0.0
AI_PORT=8000
LOG_LEVEL=info

# Qdrant Vector Database endpoint (local container or managed Qdrant Cloud)
# Local Compose default: http://qdrant:6333
# Local Host default: http://localhost:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=missing_person_faces
QDRANT_TIMEOUT_SECONDS=10.0

# Biometric face recognition engine parameters
MODEL_NAME=buffalo_l
DETECTION_SIZE=640,640
INSIGHTFACE_HOME=/root/.insightface
INSIGHTFACE_CACHE_DIR=./ai-service/models
FACE_MATCH_THRESHOLD=0.60
MAX_UPLOAD_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# 8. React Vite Frontend Configuration
# ------------------------------------------------------------------------------
# Public API base URL accessed by the user's web browser
# In production: https://api.guardianlink.org or https://yourdomain.com/api
VITE_API_BASE_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 9. Local Development Host Port Mappings
# ------------------------------------------------------------------------------
# Used by docker-compose.yml. In docker-compose.prod.yml, AI and Qdrant host ports
# are strictly unmapped for network isolation.
FRONTEND_PORT=3000
BACKEND_PORT=5000
AI_SERVICE_PORT=8000
QDRANT_HTTP_PORT=6333
MONGO_PORT=27017
REDIS_PORT=6379
MONGO_EXPRESS_PORT=8081
