# ==============================================================================
# GuardianLink — Multi-Container Docker Compose Environment Template
# ==============================================================================
# SAFE DEVELOPMENT DEFAULTS ONLY — NEVER COMMIT REAL PRODUCTION CREDENTIALS
# Copy this file to .env at the repository root for custom local configurations:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Microservice Configuration (Phase 6.5 / 6.6)
# ------------------------------------------------------------------------------
# Shared pre-shared secret key for internal service-to-service authentication
INTERNAL_SERVICE_KEY=dev_internal_secret_change_in_production

# AI microservice URL for internal backend communication
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_TIMEOUT_MS=10000

# Standalone Qdrant service URL on the Docker internal bridge network
QDRANT_URL=http://qdrant:6333

# Qdrant collection name for child facial embeddings
COLLECTION_NAME=missing_person_faces

# Network timeout in seconds for Qdrant operations
QDRANT_TIMEOUT_SECONDS=10.0

# Cosine similarity match threshold (range -1.0 to 1.0)
FACE_MATCH_THRESHOLD=0.60

# Maximum allowed image upload size in bytes (10 MB = 10485760)
MAX_UPLOAD_SIZE_BYTES=10485760

# InsightFace model pack name
MODEL_NAME=buffalo_l

# Model cache path inside container
INSIGHTFACE_HOME=/root/.insightface

# Host path containing cached buffalo_l model weights
INSIGHTFACE_CACHE_DIR=./ai-service/models

# ------------------------------------------------------------------------------
# 2. Service Port Mappings (Host:Container)
# ------------------------------------------------------------------------------
AI_SERVICE_PORT=8000
QDRANT_HTTP_PORT=6333
BACKEND_PORT=5000
FRONTEND_PORT=3000
MONGO_PORT=27017
REDIS_PORT=6379
