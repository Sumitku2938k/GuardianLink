# ==============================================================================
# GuardianLink Docker Compose Environment Configuration (guardianlinksem5og)
# ==============================================================================

# Project Name & Isolation
COMPOSE_PROJECT_NAME=guardianlinksem5og

# Application Host Ports (Default ports retained; configurable to avoid collisions)
CLIENT_PORT=3000
SERVER_PORT=5000
MONGO_EXPRESS_PORT=8081

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000

# Backend Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000
MONGO_URI=mongodb://mongo:27017/guardianlink
REDIS_URL=redis://redis:6379

# Backend Secrets (Set secure values for your deployment)
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_key_here
COOKIE_SECRET=your_cookie_secret_key_here

# Initial Admin Bootstrap Credentials
ADMIN_NAME=GuardianLink Administrator
ADMIN_EMAIL=admin@guardianlink.local
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_PHONE=9999900000

# Cloudinary Storage Configuration (Optional in local development)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Service Microservice Configuration
AI_SERVICE_URL=http://ai-service:8001
AI_SERVICE_SECRET=your_ai_internal_secret_here
AI_MATCH_THRESHOLD=0.55
GUARDIANLINK_QDRANT_COLLECTION=guardianlink_children_faces
